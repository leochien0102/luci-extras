#!/bin/sh

if [ "$PKG_UPGRADE" != 1 ]; then
	uci get luci.themes.ArgonPlus >/dev/null 2>&1 || \
	uci batch <<-EOF
		set luci.themes.ArgonPlus=/luci-static/argon-plus
		set luci.main.mediaurlbase=/luci-static/argon-plus
		commit luci
	EOF
fi

# Migration: this package replaces the upstream luci-theme-argon +
# luci-app-argon-config pair. Configuration carried over by sysupgrade can
# still reference the removed theme -- drop the dead Design entry, and take
# the slot if Argon was the active theme. Outside the PKG_UPGRADE guard on
# purpose: it is exactly the upgrade path that needs it.
if uci -q get luci.themes.Argon >/dev/null; then
	uci -q delete luci.themes.Argon
	[ "$(uci -q get luci.main.mediaurlbase)" = "/luci-static/argon" ] && \
		uci -q set luci.main.mediaurlbase=/luci-static/argon-plus
	uci -q commit luci
fi

exit 0
