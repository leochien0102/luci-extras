#!/bin/sh /etc/rc.common

USE_PROCD=1
# After shadowsocksr (S95): probing a tunnel that has not been brought up
# yet would log an incident on every boot.
START=97
STOP=10

start_service() {
	config_load ssrp-watch
	local enabled
	config_get_bool enabled config enabled 0
	[ "$enabled" -eq 1 ] || return 0

	procd_open_instance
	procd_set_param command /usr/bin/ssrp-watch -d
	# The script loops forever and handles its own INT/TERM, so any exit is
	# unexpected. Respawn, but slowly: a crash loop must not turn into a
	# flood of probe traffic.
	procd_set_param respawn 3600 10 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "ssrp-watch"
}
